[Unit]
Description=ChmlFrp Community Toolbox Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chmlfrp-daemon
Group=chmlfrp-daemon
SupplementaryGroups=systemd-journal
ExecStart=/usr/bin/chmlfrp-toolbox-daemon --config /etc/chmlfrp-toolbox-daemon/config.toml start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 安全限制
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/chmlfrp-toolbox-daemon /etc/chmlfrp-toolbox-daemon
PrivateTmp=true

# 环境变量（日志级别）
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
